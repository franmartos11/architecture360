# Copiá este archivo a .env.local (que ya está en .gitignore) y completá
# los 3 valores con los de tu proyecto en https://supabase.com/dashboard
# → Project Settings → API.
#
# Mientras este archivo no exista como .env.local, el sitio sigue
# funcionando igual que ahora (con data/mockData.ts) — no hace falta
# completarlo para seguir trabajando en otras cosas.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role
# ⚠️ Esta clave ignora todos los permisos (RLS). Nunca debe llevar el
# prefijo NEXT_PUBLIC_ ni usarse en código de cliente — solo en rutas
# API del server (ver lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — subdominios por proyecto (mi-proyecto.tudominio.com), al
# estilo de cómo Vercel le da su propia URL a cada deploy. Mientras esto
# no esté seteado, cada proyecto se sigue viendo en /proyecto/[slug] como
# siempre. Requiere tener un dominio propio (no funciona sobre *.vercel.app)
# con un registro DNS wildcard (*.tudominio.com) apuntando a Vercel, y
# agregar ese wildcard en Vercel → Project Settings → Domains. Ver proxy.ts.
# Formato: sin protocolo, sin www (ej: architecture360.com).
NEXT_PUBLIC_ROOT_DOMAIN=

# Opcional — notificaciones por email (nuevo lead, invitación a
# colaborar, crédito confirmado). Sin esto seteado, la app sigue
# funcionando igual: los envíos quedan como no-op (ver lib/email.ts).
# Creá una cuenta gratis en https://resend.com → API Keys.
RESEND_API_KEY=

# Opcional — remitente de esos emails. Mientras no verifiques un dominio
# propio en Resend, dejá el default de pruebas (onboarding@resend.dev).
EMAIL_FROM=

# Opcional — Google Maps. Con la clave del server (GOOGLE_MAPS_API_KEY) se
# calculan los tiempos de viaje de los puntos de interés (Distance Matrix
# API). Con la clave pública (NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, restringida
# por dominio, con Maps JavaScript API habilitada) el mapa del picker de
# ubicación pasa a ser Google Maps en vez de OpenStreetMap. Ambas requieren
# una cuenta de facturación en Google Cloud. Sin ninguna de las dos, la app
# sigue funcionando con leaflet/OSM y sin cálculo automático de tiempos.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
