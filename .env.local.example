# Copiá este archivo a .env.local (que ya está en .gitignore) y completá
# los 3 valores con los de tu proyecto en https://supabase.com/dashboard
# → Project Settings → API.
#
# Mientras este archivo no exista como .env.local, el sitio sigue
# funcionando igual que ahora (con data/mockData.ts) — no hace falta
# completarlo para seguir trabajando en otras cosas.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role
# ⚠️ Esta clave ignora todos los permisos (RLS). Nunca debe llevar el
# prefijo NEXT_PUBLIC_ ni usarse en código de cliente — solo en rutas
# API del server (ver lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
