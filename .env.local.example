# Copiá este archivo a .env.local (que ya está en .gitignore) y completá
# los 3 valores con los de tu proyecto en https://supabase.com/dashboard
# → Project Settings → API.
#
# Mientras este archivo no exista como .env.local, el sitio sigue
# funcionando igual que ahora (con data/mockData.ts) — no hace falta
# completarlo para seguir trabajando en otras cosas.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role
# ⚠️ Esta clave ignora todos los permisos (RLS). Nunca debe llevar el
# prefijo NEXT_PUBLIC_ ni usarse en código de cliente — solo en rutas
# API del server (ver lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — subdominios por proyecto (mi-proyecto.tudominio.com), al
# estilo de cómo Vercel le da su propia URL a cada deploy. Mientras esto
# no esté seteado, cada proyecto se sigue viendo en /proyecto/[slug] como
# siempre. Requiere tener un dominio propio (no funciona sobre *.vercel.app)
# con un registro DNS wildcard (*.tudominio.com) apuntando a Vercel, y
# agregar ese wildcard en Vercel → Project Settings → Domains. Ver proxy.ts.
# Formato: sin protocolo, sin www (ej: architecture360.com).
NEXT_PUBLIC_ROOT_DOMAIN=

# Opcional — notificaciones por email (nuevo lead, invitación a
# colaborar, crédito confirmado). Sin esto seteado, la app sigue
# funcionando igual: los envíos quedan como no-op (ver lib/email.ts).
# Creá una cuenta gratis en https://resend.com → API Keys.
RESEND_API_KEY=

# Opcional — remitente de esos emails. Mientras no verifiques un dominio
# propio en Resend, dejá el default de pruebas (onboarding@resend.dev).
EMAIL_FROM=

# Google Maps (necesario para Ubicación/entorno en el admin). Dos claves:
# - GOOGLE_MAPS_API_KEY (solo servidor): Places API (New) para el buscador
#   de lugares/direcciones y Routes API para los tiempos de viaje.
# - NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (pública, va al navegador): solo Maps
#   JavaScript API, restringida por dominio (+ localhost para dev).
# Ambas requieren facturación en Google Cloud. Sin la pública los mapas del
# admin muestran un aviso; sin la del servidor no hay buscador ni tiempos.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opcional — bot de WhatsApp. Nombre de la máquina del puente (el BOT_HOST
# de su .env.bot) a la que se asigna cada bot nuevo al guardarlo o vincularlo
# desde el panel. En local, el de tu máquina de pruebas; en producción, el
# del servidor real. Sin esto, hay que asignarlo a mano en Supabase
# (update wa_bots set host_permitido = '...'). Nunca mueve un bot que ya
# tiene máquina.
WA_BOT_HOST_DEFAULT=

# Opcional — dominios propios por proyecto (www.tuproyecto.com), con alta y
# verificación desde el panel (Ajustes → Dominio propio). Sin estas variables
# esa sección avisa que el alta es manual (se carga la fila en project_domains
# y el dominio en Vercel a mano). Necesitan un plan Pro de Vercel.
#   VERCEL_TOKEN:       Vercel → Account Settings → Tokens (con acceso al equipo)
#   VERCEL_PROJECT_ID:  Vercel → el proyecto → Settings → General → Project ID
#   VERCEL_TEAM_ID:     solo si el proyecto es de un equipo (Team Settings → General)
# ⚠️ El token puede administrar dominios: nunca con prefijo NEXT_PUBLIC_.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Secreto del cron diario que revisa los dominios propios (vercel.json →
# /api/cron/dominios): libera reservas pendientes de más de 7 días y baja los
# dominios activos cuyo DNS ya no apunta a Vercel. Vercel lo manda solo en el
# header Authorization cuando la variable existe; sin ella el cron no hace
# nada. Un valor largo y al azar (por ejemplo: openssl rand -hex 32).
CRON_SECRET=

# Opcional — secreto con el que se firman los links de baja de las novedades
# de obra por correo (ver lib/unsubscribe-token.ts). Si no está, se usa
# SUPABASE_SERVICE_ROLE_KEY; con este propio, rotar la clave de Supabase no
# invalida los links de baja de correos ya enviados. Nunca con NEXT_PUBLIC_.
LEADS_UNSUBSCRIBE_SECRET=
