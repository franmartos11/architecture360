# Variables del puente de WhatsApp (pnpm bot). Copiá este archivo a .env.bot
# en el servidor donde corre el puente y completalo. .env.bot no se commitea.

# Supabase 360 (service role: el puente se saltea RLS).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (la IA del bot).
ANTHROPIC_API_KEY=

# Nombre de este servidor, obligatorio y sin default. El puente solo toma los
# bots cuyo wa_bots.host_permitido es exactamente este valor: así una notebook
# de desarrollo nunca toma un bot real.
BOT_HOST=

# URL pública del admin, para el link "Ver chat" del aviso al vendedor
# (ej. https://tu-dominio.com).
ADMIN_BASE_URL=

# Opcional: email de "nuevo lead" al dueño y al equipo comercial (gestores y
# administradores) cuando el bot avisa.
RESEND_API_KEY=
EMAIL_FROM=
