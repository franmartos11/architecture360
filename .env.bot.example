# Variables del puente de WhatsApp (pnpm bot). Copiá este archivo a .env.bot
# en el servidor donde corre el puente y completalo. .env.bot no se commitea.

# Supabase 360 (service role: el puente se saltea RLS).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (la IA del bot).
ANTHROPIC_API_KEY=
# Solo si la clave no está asignada a un workspace (la API lo pide): el ID del
# workspace, en console.anthropic.com → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Nombre de este servidor, obligatorio y sin default. El puente solo toma los
# bots cuyo wa_bots.host_permitido es exactamente este valor: así una notebook
# de desarrollo nunca toma un bot real.
BOT_HOST=

# URL pública del admin, para el link "Ver chat" del aviso al vendedor
# (ej. https://tu-dominio.com).
ADMIN_BASE_URL=

# Opcional: email de "nuevo lead" al dueño y al equipo comercial (gestores y
# administradores) cuando el bot avisa.
RESEND_API_KEY=
EMAIL_FROM=

# Opcional: transcripción de los audios del cliente (Claude no transcribe audio).
# Cualquier servicio compatible con /v1/audio/transcriptions de OpenAI
# (OpenAI Whisper, Groq, etc.). Sin clave, los audios no se transcriben y el
# bot le pide al cliente que lo escriba. Los audios se mandan a ese servicio.
TRANSCRIPCION_API_KEY=
TRANSCRIPCION_URL=
TRANSCRIPCION_MODELO=
